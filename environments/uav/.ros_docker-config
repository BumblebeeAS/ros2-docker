# Build parameters, used by ros2-docker build
CONFIG_IMAGE_KEY=apt_cache.gscam.noble_pip.ultralytics_cuda.micro_xrce_dds_agent.ccache.uav.install_env.mavsdk_native.ros2_python_pins
CONFIG_DOCKER_SEARCH_DIRS=(
    "dockerfiles/common"
    "dockerfiles/environments"
    "dockerfiles/arm64"
)

BUILT_IMAGE=isaac-ros-uav:latest

# Must match the flight controller uXRCE-DDS domain (UXRCE_DDS_DOM_ID).
CONFIG_ROS_DOMAIN_ID=38

# Ordinary UAV DDS participants stay onboard. The cross-domain bridge selects
# its ASV input profile separately; profile files come from mounted bring-up.
ISAAC_ROS_DOCKER_ARGS+=(
    -e "RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
    -e "FASTDDS_DEFAULT_PROFILES_FILE=${FASTDDS_DEFAULT_PROFILES_FILE:-/workspaces/isaac_ros-dev/src/bring-up/etc/uav/fastdds_local.xml}"
)

# Note that env variables like $HOME cannot be unpacked here
MOUNT_DIRS=(
    "$HOME/workspaces/isaac_ros-dev:/workspaces/isaac_ros-dev"
    "$HOME/.cache/ccache:/home/admin/.cache/ccache"
    "$HOME/.cache/torch:/home/admin/.cache/torch"
    "$HOME/.cache/matplotlib:/home/admin/.cache/matplotlib"
)
WORKDIR=/workspaces/isaac_ros-dev
DOCKER_CONTEXT_DIR=.
DOCKER_BUILD_BASE_IMAGE=nvcr.io/nvidia/isaac/ros:isaac_ros_1742a70509cba44cb1943ab200bbece1-arm64-jetpack

# GStreamer CSI capture connects to the host Argus daemon (issue #16).
REQUIRE_ARGUS=1
