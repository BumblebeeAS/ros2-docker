<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>uav_asv_bridge_udp</transport_id>
        <type>UDPv4</type>
        <!-- Allow discovery of ASV participants. -->
        <maxInitialPeersRange>120</maxInitialPeersRange>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>uav_asv_bridge_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="uav_asv_input" is_default_profile="true">
      <domainId>2</domainId>
      <rtps>
        <!-- Pinned so the router's domain-2 discovery port is always 7910
             (7400 + 250*2 + 10). The ASV5 profile (bring-up
             etc/asv5_orin/fastdds_unicast.xml) peers 192.168.16.50:7910 with an
             explicit port instead of probing 120 ports over the Microhard.
             If another domain-2 participant already holds ID 0 on the UAV,
             the router fails to start instead of silently moving ports. -->
        <participantID>0</participantID>
        <builtin>
          <initialPeersList>
            <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
            <locator><udpv4><address>192.168.11.50</address></udpv4></locator>
          </initialPeersList>
          <metatrafficUnicastLocatorList>
            <locator><udpv4><address>0.0.0.0</address></udpv4></locator>
          </metatrafficUnicastLocatorList>
        </builtin>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>uav_asv_bridge_udp</transport_id>
          <transport_id>uav_asv_bridge_shm</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
