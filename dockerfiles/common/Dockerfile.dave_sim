ARG BASE_IMAGE
FROM $BASE_IMAGE

ARG ROS_DISTRO=jazzy
ARG DAVE_BRANCH=ros2

# Adapted from DAVE's standalone amd64 image. ArduSub SITL and QGroundControl are
# intentionally omitted; this image only provides the DAVE/Gazebo sim stack.
# https://github.com/IOES-Lab/dave/blob/ros2/.docker/jazzy.amd64.dockerfile

# Gazebo Harmonic ships from the OSRF apt repository rather than the ROS one.
# https://github.com/IOES-Lab/dave/blob/ros2/extras/ros-jazzy-gz-harmonic-install.sh
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg && \
    curl https://packages.osrfoundation.org/gazebo.gpg \
        --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    . /etc/os-release && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/gazebo-stable.list

# Dependencies from the upstream DAVE installer, which the upstream Dockerfile
# runs as extras/ros-jazzy-gz-harmonic-install.sh. Its ArduPilot build deps
# (python3-pexpect, python3-wxgtk4.0, bison, flex, automake) and its ROS apt
# source and rosdep bootstrap are left out. mavros goes too, but mavros_msgs
# stays — dave_robot_models' teleop node imports it with or without an autopilot.
#
# gstreamer, python3-gi, python3-gst-1.0, ffmpeg and rapidjson-dev are ArduSub
# deps. cython3 and python3-lxml come from the same upstream block in 
# https://github.com/IOES-Lab/dave/blob/ros2/extras/ros-jazzy-gz-harmonic-install.sh 
# with no identified consumer. Nothing in DAVE references any of them.
#
# Upstream's gnupg2 is also skipped: on Noble it is an empty transitional package
# whose only content is "Depends: gnupg", which is installed above.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    cppcheck \
    cppzmq-dev \
    curl \
    dirmngr \
    git \
    gnupg \
    gz-harmonic \
    libeigen3-dev \
    libgles2-mesa-dev \
    libgz-sim8-dev \
    libopencv-dev \
    libprotobuf-dev \
    libxcb-cursor-dev \
    libxcb-xinerama0 \
    libxkbcommon-x11-0 \
    lsb-release \
    mesa-utils \
    pkg-config \
    protobuf-compiler \
    python-is-python3 \
    python3-catkin-pkg \
    python3-colcon-common-extensions \
    python3-dev \
    python3-future \
    python3-pip \
    python3-rosdep \
    python3-rosinstall-generator \
    python3-vcstool \
    python3-venv \
    python3-websockets \
    ros-${ROS_DISTRO}-effort-controllers \
    ros-${ROS_DISTRO}-geographic-info \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-joy-linux \
    ros-${ROS_DISTRO}-joy-teleop \
    ros-${ROS_DISTRO}-key-teleop \
    ros-${ROS_DISTRO}-marine-acoustic-msgs \
    ros-${ROS_DISTRO}-mavros-msgs \
    ros-${ROS_DISTRO}-moveit-planners \
    ros-${ROS_DISTRO}-moveit-ros-visualization \
    ros-${ROS_DISTRO}-moveit-simple-controller-manager \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-ros-gz \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-teleop-tools \
    ros-${ROS_DISTRO}-urdfdom-py \
    ruby \
    software-properties-common \
    sudo \
    wget \
    x11-apps \
    xauth \
    xterm

# Resolve and build the actual DAVE workspace. DAVE is not released to the ROS
# index, so it has to be built from source, but only the dave repo itself is
# cloned: upstream's dave.repos also lists dockwater and rocker, host-side Docker
# tooling that this repository replaces (and rocker's setup.py would be picked up
# as a colcon build target).
# https://github.com/IOES-Lab/dave/blob/ros2/extras/repos/dave.jazzy.repos
#
# dave_robot_models exec_depends on mavros, which is only useful alongside the
# ArduSub SITL this image omits, so rosdep skips it; the GeographicLib geoid
# datasets it would have needed are skipped with it.
ENV DAVE_WS=/opt/dave_ws
WORKDIR ${DAVE_WS}/src
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    git clone --depth 1 --branch ${DAVE_BRANCH} https://github.com/IOES-Lab/dave.git && \
    apt-get update && \
    rosdep update --rosdistro ${ROS_DISTRO} && \
    rosdep install --rosdistro ${ROS_DISTRO} -iy --from-paths . --skip-keys mavros

WORKDIR ${DAVE_WS}
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install

WORKDIR /
