ARG BASE_IMAGE
FROM eprosima/vulcanexus:jazzy-cloud@sha256:7028da65320a0c6a5791e4bd5ca4d07e45390e36632e83074e5e7b97df3cbf0d AS router
FROM $BASE_IMAGE

COPY --from=router /opt/vulcanexus/jazzy/bin/ddsrouter /opt/ddsrouter/bin/ddsrouter.bin
COPY --from=router /opt/vulcanexus/jazzy/lib/*.so* /opt/ddsrouter/lib/
COPY --from=router /usr/lib/*/libtinyxml2.so.10* /opt/ddsrouter/lib/
COPY --from=router /usr/lib/*/libyaml-cpp.so.0.8* /opt/ddsrouter/lib/
COPY --chmod=755 dockerfiles/common/ddsrouter /opt/ddsrouter/bin/ddsrouter
RUN /opt/ddsrouter/bin/ddsrouter --version
