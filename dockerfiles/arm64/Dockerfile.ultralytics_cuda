ARG BASE_IMAGE
FROM $BASE_IMAGE

# NVIDIA Jetson setup source (JetPack 7.2):
# https://docs.ultralytics.com/guides/nvidia-jetson/#run-on-jetpack-72

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu130

# Install the remaining dependencies explicitly instead of using
# ultralytics[export] so pip cannot replace the CUDA PyTorch builds or the
# ROS-compatible NumPy/OpenCV versions.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps \
    ultralytics \
    ultralytics-thop

# Dependencies for ultralytics excluding torch and torchvision
# Obtained from "pip show ultralytics" + "onnxslim" and "onnx" for exporting of models
# OpenCV 4.12 requires "numpy<2.3.0,>=2", which is not compatible with ROS packages
# So we install an older version of OpenCV
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    filelock \
    matplotlib \
    "numpy<2" \
    nvidia-ml-py \
    "onnx<1.18" \
    onnxslim \
    "opencv-python<4.12" \
    pandas \
    pillow \
    polars \
    psutil \
    py-cpuinfo \
    pyyaml \
    requests \
    scipy \
    tqdm

# PyPI does not publish onnxruntime-gpu wheels for Linux arm64. Ultralytics
# provides this Python 3.12 / JetPack 7.2-compatible GPU wheel for exports.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    https://github.com/ultralytics/assets/releases/download/v0.0.0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl
