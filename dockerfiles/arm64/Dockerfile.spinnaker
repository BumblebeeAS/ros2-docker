ARG BASE_IMAGE
FROM $BASE_IMAGE
ARG ROS_DISTRO=jazzy
ARG SPINNAKER_VERSION=4.3.0.189
# Change the URL to the latest version if needed
ARG SPINNAKER_URL=https://flir.netx.net/file/asset/73905/original/attachment

# NOTE: Teledyne distributes this arm64 SDK build for Ubuntu 22.04. Its Debian
# dependencies are currently installable on Noble, but Ubuntu 24.04 is not a
# vendor-published target for this artifact.

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update && \
  apt-get install -y \
  debconf-utils \
  libusb-1.0-0 \
  qtbase5-dev \
  qtchooser \
  qt5-qmake \
  qtbase5-dev-tools

# Skip the EULA agreement and analytics prompts, which cannot be bypassed by pressing Enter.
# Get the keys from `debconf-show libgentl`
RUN debconf-set-selections <<'EOF'
libgentl libspinnaker/accepted-flir-eula boolean true
libgentl libspinnaker/analytics-consent boolean false
EOF

# Download, extract, install, and remove the vendor archive in one layer so the
# installer contents are not retained in the image.
# Source: install_spinnaker_arm.sh
# TODO: groupadd -f flirimaging && usermod -a -G flirimaging ${USERNAME} in configure_spinnaker.sh
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  archive="/tmp/spinnaker-${SPINNAKER_VERSION}-arm64.tar.gz" && \
  wget -q -O "$archive" "$SPINNAKER_URL" && \
  mkdir -p /tmp/spinnaker-installer && \
  tar -xzf "$archive" -C /tmp/spinnaker-installer --strip-components=1 && \
  cd /tmp/spinnaker-installer && \
  apt-get update && \
  DEBIAN_FRONTEND=noninteractive apt-get install -y ./*.deb && \
  yes "" | sh configure_spinnaker.sh && \
  sh configure_usbfs.sh && \
  sh configure_spinnaker_paths.sh && \
  sh configure_gentl_paths.sh 64 && \
  cd / && \
  rm -rf /tmp/spinnaker-installer "$archive"

# Running with Xephyr fixes flickering issue when running SpinView
# Install ROS package for Spinnaker camera driver
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update -y || true && \
  apt-get install -y \
  xserver-xephyr \
  ros-${ROS_DISTRO}-spinnaker-camera-driver
