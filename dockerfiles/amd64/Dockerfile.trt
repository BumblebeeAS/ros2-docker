ARG BASE_IMAGE
FROM $BASE_IMAGE

# Use the Isaac ROS base image's NVIDIA apt preferences for TensorRT versions.
# Pinning only the Python bindings to an older release conflicts with the
# preferred native libraries, which must have exactly matching versions.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    python3-libnvinfer \
    python3-libnvinfer-lean \
    python3-libnvinfer-dispatch
