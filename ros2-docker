#!/usr/bin/env bash

set -euo pipefail

ERROR='\033[0;31m'
SUCCESS='\033[0;32m'
WARNING='\033[0;33m'
INFO='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ros-docker"
PROJECT_ROOT_FILE="$CONFIG_DIR/project_root"
ENVIRONMENT_FILE="$CONFIG_DIR/environment"
READY_FILE=/tmp/.ros2-docker-ready
ISAAC_ROS_DOCKER_ARGS=(
    -e ISAAC_ROS_WS=/workspaces/isaac_ros-dev
    --entrypoint /usr/local/bin/scripts/workspace-entrypoint.sh
)

find_project_root() {
    local candidate dir
    for candidate in "${ROS_DOCKER_PROJECT_ROOT:-}" "$(cat "$PROJECT_ROOT_FILE" 2>/dev/null || true)"; do
        if [[ -n "$candidate" && -f "$candidate/build_image_layers.sh" ]]; then
            printf "%s" "$candidate"
            return
        fi
    done

    for dir in "$SCRIPT_DIR" "$PWD"; do
        while [[ "$dir" != "/" ]]; do
            if [[ -f "$dir/build_image_layers.sh" ]]; then
                printf "%s" "$dir"
                return
            fi
            dir=$(dirname "$dir")
        done
    done

    printf '%b%s%b\n' "$ERROR" "Could not find the ros2-docker project root." "$NC" >&2
    printf '%b%s%b\n' "$INFO" "Set ROS_DOCKER_PROJECT_ROOT or rerun ./setup.sh." "$NC" >&2
    exit 1
}

PROJECT_ROOT=$(find_project_root)

usage() {
    printf "Usage: ros2-docker <command> [options]\n"
    printf "\nCommands:\n"
    printf "    use <environment>       Select the default environment.\n"
    printf "    environments            List available environments.\n"
    printf "    build [-r]              Build the selected environment image.\n"
    printf "        -r, --rebuild       Rebuild without Docker's layer cache.\n"
    printf "    up                      Start the container in the background.\n"
    printf "    start                   Start the container, then open a shell.\n"
    printf "    exec <cmd>              Run a command in the running container.\n"
    printf "    down                    Stop and remove the container.\n"
    printf "    list                    List running containers and images.\n"
    printf "    config                  Print the active environment config.\n"
    printf "    -h | --help             Show this help message.\n"
}

list_environments() {
    local config
    for config in "$PROJECT_ROOT"/environments/*/.ros_docker-config; do
        [[ -f "$config" ]] && basename "$(dirname "$config")"
    done
}

select_environment() {
    local environment="$1"
    if [[ ! -f "$PROJECT_ROOT/environments/$environment/.ros_docker-config" ]]; then
        printf "${ERROR}Unknown environment: %s${NC}\n" "$environment" >&2
        printf '%b%s%b\n' "$INFO" "Available environments:" "$NC" >&2
        list_environments >&2
        exit 1
    fi
    mkdir -p "$CONFIG_DIR"
    printf "%s" "$environment" > "$ENVIRONMENT_FILE"
    printf "${SUCCESS}Default environment set to: %s${NC}\n" "$environment"
}

load_environment() {
    ENVIRONMENT="$(cat "$ENVIRONMENT_FILE" 2>/dev/null || true)"

    if [[ -z "$ENVIRONMENT" ]]; then
        printf '%b%s%b\n' "$ERROR" "No environment selected." "$NC" >&2
        printf '%b%s%b\n' "$INFO" "Run: ros2-docker use <environment>" "$NC" >&2
        exit 1
    fi
    printf "${INFO}Environment: %s${NC}\n" "$ENVIRONMENT" >&2

    ENV_FILE="$PROJECT_ROOT/environments/$ENVIRONMENT/.ros_docker-config"
    if [[ ! -f "$ENV_FILE" ]]; then
        printf "${ERROR}Environment config not found: %s${NC}\n" "$ENV_FILE" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$ENV_FILE"

    # Keep the runtime implementation explicit while retaining the established
    # isaac_ros_common configuration names in each environment file.
    ENVIRONMENT_NAME="${ENVIRONMENT_NAME:-$ENVIRONMENT}"
    CONTAINER_NAME="${CONTAINER_NAME:-isaac-ros-${ENVIRONMENT_NAME//_/-}}"
    DOCKER_IMAGE_NAME="$BUILT_IMAGE"
}

container_exists() {
    docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1
}

container_running() {
    [[ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || true)" == "true" ]]
}

ensure_image_exists() {
    if ! docker image inspect "$DOCKER_IMAGE_NAME" >/dev/null 2>&1; then
        printf "${WARNING}Image '%s' not found. Build it with: ros2-docker build${NC}\n" \
            "$DOCKER_IMAGE_NAME"
        return 1
    fi
}

build_image() {
    if container_running; then
        printf "${WARNING}%s is running. Stop it first with: ros2-docker down${NC}\n" "$CONTAINER_NAME"
        exit 1
    fi

    local -a build_args=(
        --config "$ENV_FILE"
        --build_arg "HOST_USER_UID=$(id -u)"
        --build_arg "HOST_USER_GID=$(id -g)"
    )

    case "${1:-}" in
        "") ;;
        -r | --rebuild) build_args+=(--rebuild) ;;
        *) printf "${ERROR}Invalid build option: %s${NC}\n" "$1" >&2; exit 1 ;;
    esac
    "$PROJECT_ROOT/build_image_layers.sh" "${build_args[@]}"
}

exec_in_container() {
    if ! container_running; then
        printf "${WARNING}No running container named '%s'. Use: ros2-docker start${NC}\n" "$CONTAINER_NAME"
        return 1
    fi

    if [[ $# -gt 0 ]]; then
        printf "${INFO}Executing in %s: %s${NC}\n" "$CONTAINER_NAME" "$*"
        docker exec -it -u admin \
            --workdir "$WORKDIR" "$CONTAINER_NAME" bash -lc "$*"
    else
        printf "${INFO}Attaching to: %s${NC}\n" "$CONTAINER_NAME"
        docker exec -it -u admin \
            --workdir "$WORKDIR" "$CONTAINER_NAME" bash
    fi
}

# The requested command touches READY_FILE after the image entrypoint hands off.
wait_for_entrypoint() {
    timeout 60 docker exec "$CONTAINER_NAME" \
        bash -c "until [ -e $READY_FILE ]; do sleep 0.1; done" >/dev/null 2>&1 && return 0
    printf "${WARNING}Timed out waiting for %s to finish starting.${NC}\n" "$CONTAINER_NAME" >&2
    return 1
}

up() {
    if container_running; then
        printf "${INFO}%s is already running.${NC}\n" "$CONTAINER_NAME"
        return
    fi
    if container_exists; then
        printf "${WARNING}Removing stopped container: %s${NC}\n" "$CONTAINER_NAME"
        docker rm "$CONTAINER_NAME" >/dev/null
    fi
    ensure_image_exists || return 1

    if command -v xhost >/dev/null 2>&1; then
        xhost "+SI:localuser:$(id -un)" >/dev/null 2>&1 || true
    fi

    # Container arguments mirror upstream Isaac ROS run_dev.py:
    # https://github.com/NVIDIA-ISAAC-ROS/isaac-ros-cli/blob/release-4.6/scripts/run_dev/run_dev.py
    local -a DOCKER_ARGS=(
        --name "$CONTAINER_NAME"
        --network host
        --ipc host
        --privileged
        --runtime nvidia
        -e "DISPLAY=${DISPLAY:-}"
        -e NVIDIA_VISIBLE_DEVICES=all
        -e NVIDIA_DRIVER_CAPABILITIES=all
        -e "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}"
        -e "HOST_USER_UID=$(id -u)"
        -e "HOST_USER_GID=$(id -g)"
        -v /tmp/.X11-unix:/tmp/.X11-unix
        -v /etc/localtime:/etc/localtime:ro
        -v /dev:/dev
        -v /run/udev:/run/udev:ro
        --group-add video
    )
    DOCKER_ARGS+=( "${ISAAC_ROS_DOCKER_ARGS[@]}" )

    [[ -f "$HOME/.Xauthority" ]] && DOCKER_ARGS+=( -v "$HOME/.Xauthority:/home/admin/.Xauthority:rw" )
    [[ -f "$HOME/.gitconfig" ]] && DOCKER_ARGS+=( -v "$HOME/.gitconfig:/home/admin/.gitconfig:ro" )
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        DOCKER_ARGS+=( -v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent )
    fi
    local mount_source
    for mount_dir in "${MOUNT_DIRS[@]}"; do
        mount_source="${mount_dir%%:*}"
        if [[ "$mount_source" = /* && ! -e "$mount_source" ]]; then
            mkdir -p "$mount_source"
        fi
        DOCKER_ARGS+=( -v "$mount_dir" )
    done

    # Matches
    # https://github.com/NVIDIA-ISAAC-ROS/isaac-ros-cli/blob/b1eca83031c8c55d69f9ee383c1319cd8cb53eba/scripts/run_dev/run_dev.py#L245-L256
    # Skip the /dev/input and /dev/bus/usb mounts and the --device=/dev/coe-chan-*
    # flags in upstream run_dev.py: we bind-mount all of /dev instead
    if [[ "$(uname -m)" == "aarch64" ]]; then
        DOCKER_ARGS+=( --pid host )
        # /sys/kernel/debug is required by tegrastats
        [[ -e /usr/bin/tegrastats ]] && DOCKER_ARGS+=( -v /usr/bin/tegrastats:/usr/bin/tegrastats -v /sys/kernel/debug:/sys/kernel/debug:ro )
        [[ -d /usr/lib/aarch64-linux-gnu/tegra ]] && DOCKER_ARGS+=( -v /usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/tegra )
        [[ -d /usr/src/jetson_multimedia_api ]] && DOCKER_ARGS+=( -v /usr/src/jetson_multimedia_api:/usr/src/jetson_multimedia_api )
        [[ -d /usr/src/jetson_sipl_api ]] && DOCKER_ARGS+=( -v /usr/src/jetson_sipl_api:/usr/src/jetson_sipl_api )
        [[ -d /usr/share/vpi3 ]] && DOCKER_ARGS+=( -v /usr/share/vpi3:/usr/share/vpi3 )
        [[ -d /usr/share/vpi4 ]] && DOCKER_ARGS+=( -v /usr/share/vpi4:/usr/share/vpi4 )
        [[ -S /run/jtop.sock ]] && DOCKER_ARGS+=( -v /run/jtop.sock:/run/jtop.sock:ro )
    fi

    # Grant the container user the device groups by GID, resolved here on the
    # host. Docker applies --group-add when it creates each process -- including
    # `docker exec` ones -- without consulting the container's /etc/group, so
    # this is immune to the entrypoint's asynchronous edits to that file, which
    # `docker exec` would otherwise race. Same pattern upstream run_dev.py uses
    # for jtop:
    # https://github.com/NVIDIA-ISAAC-ROS/isaac-ros-cli/blob/release-4.6/scripts/run_dev/run_dev.py#L261-L270
    local dev gid
    local -a device_gids=()
    for dev in /dev/dri/render* /dev/i2c-* /dev/gpiochip* /run/jtop.sock; do
        [[ -e "$dev" ]] || continue
        gid=$(stat -c %g "$dev" 2>/dev/null) || continue
        [[ "$gid" == "0" ]] && continue                        # root-owned: no group to join
        [[ " ${device_gids[*]-} " == *" $gid "* ]] && continue  # dedupe (14x i2c, 3x render)
        device_gids+=( "$gid" )
    done
    for gid in ${device_gids[@]+"${device_gids[@]}"}; do
        DOCKER_ARGS+=( --group-add "$gid" )
    done

    printf "${INFO}Starting %s from %s${NC}\n" "$CONTAINER_NAME" "$DOCKER_IMAGE_NAME"
    # errexit is off in `up`'s callers, so without `|| return 1` a failed
    # `docker run` would fall through and up() would return
    # wait_for_entrypoint's status, masking the failure.
    docker run -d "${DOCKER_ARGS[@]}" "$DOCKER_IMAGE_NAME" \
        bash -c "touch $READY_FILE; exec tail -f /dev/null" || return 1
    wait_for_entrypoint
}

down() {
    docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
    docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
    if command -v xhost >/dev/null 2>&1; then
        xhost "-SI:localuser:$(id -un)" >/dev/null 2>&1 || true
    fi
    printf "${SUCCESS}Stopped: %s${NC}\n" "$CONTAINER_NAME"
}

COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage; exit 0; }
shift || true

case "$COMMAND" in
    use) [[ $# -eq 1 ]] || { usage; exit 1; }; select_environment "$1" ;;
    environments) list_environments ;;
    -h | --help | help) usage ;;
    *)
        load_environment
        case "$COMMAND" in
            build) build_image "${1:-}" ;;
            up) up ;;
            start) up && exec_in_container ;;
            exec) exec_in_container "$@" ;;
            down) down ;;
            list)
                printf '%b%s%b\n' "$INFO" "RUNNING CONTAINERS:" "$NC"
                docker ps
                printf '\n%b%s%b\n' "$INFO" "BUILT IMAGES:" "$NC"
                docker image list
                ;;
            config) printf "%s\n" "$ENV_FILE"; sed -n '1,240p' "$ENV_FILE" ;;
            *) usage; exit 1 ;;
        esac
        ;;
esac
